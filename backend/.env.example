# backend/.env.example — copy to .env and fill in values

APP_NAME="Used Car Price Prediction API"
APP_VERSION="1.0.0"
DEBUG=false

# CORS origins (comma-separated in production)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database — swap for PostgreSQL in production
# DATABASE_URL=postgresql://user:password@localhost:5432/carpricedb
DATABASE_URL=sqlite:///./predictions.db

# ML artifact paths (relative to backend/)
MODEL_PATH=backend/ml/artifacts/car_price_model.pkl
FEATURES_PATH=backend/ml/artifacts/feature_config.json
METADATA_PATH=backend/ml/artifacts/model_metadata.json
